rules_version = '2';

// Film Room Firestore security rules.
//
// Conservative owner/editor/viewer model for Games (Phase 0) plus Teams (Phase 1–2)
// and the existing per-user savedSessions. Realtime Database rooms are NOT
// covered here (they use RTDB rules separately).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Per-user saved session templates -----------------------------
    function isPublicSharedSession() {
      return resource.data.isShared == true &&
             resource.data.shareId is string &&
             resource.data.shareId.size() > 0;
    }

    // User profile doc (YouTube onboarding, etc.) — owner-only. Subcollections
    // below keep their own rules (this match is non-recursive).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/savedSessions/{sessionId} {
      allow read: if (request.auth != null && request.auth.uid == userId) ||
                     isPublicSharedSession();
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/uploadJobs/{jobId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/cameraPresets/{presetId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/persons/{personId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    function isPublicSharedHighlightReel() {
      return resource.data.isShared == true &&
             resource.data.shareId is string &&
             resource.data.shareId.size() > 0 &&
             resource.data.kind == 'highlight';
    }

    match /{path=**}/savedSessions/{sessionId} {
      allow read: if isPublicSharedSession();
    }

    // ---- Teams --------------------------------------------------------
    function teamData(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data;
    }
    function teamRoleOf(teamId, uid) {
      return teamData(teamId).members[uid];
    }
    function isTeamMember(teamId, uid) {
      return teamData(teamId).ownerId == uid || teamRoleOf(teamId, uid) != null;
    }
    function isTeamAdmin(teamId, uid) {
      return teamData(teamId).ownerId == uid || teamRoleOf(teamId, uid) == 'admin';
    }
    function isTeamCoach(teamId, uid) {
      let role = teamRoleOf(teamId, uid);
      return isTeamAdmin(teamId, uid) || role == 'coach';
    }
    function canTeamContributeSources(teamId, uid) {
      let role = teamRoleOf(teamId, uid);
      return isTeamAdmin(teamId, uid) || role == 'coach' || role == 'parent';
    }
    function isTeamCoachOf(tid) {
      return request.auth != null && isTeamCoach(tid, request.auth.uid);
    }
    function isTeamAdminOf(tid) {
      return request.auth != null && isTeamAdmin(tid, request.auth.uid);
    }
    function isValidNewTeamCreate() {
      return request.auth != null &&
             request.resource.data.ownerId == request.auth.uid &&
             request.resource.data.members is map &&
             request.resource.data.memberUids is list &&
             request.resource.data.members[request.auth.uid] == 'admin' &&
             request.resource.data.memberUids.hasAll([request.auth.uid]);
    }
    /** Query-compatible team read (resource.data — not get()). */
    function canReadTeamResource() {
      return request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.memberUids
      );
    }
    function parentInviteEmailMatchesAuth() {
      return request.auth != null &&
             request.auth.token.email is string &&
             resource.data.email is string &&
             resource.data.email.lower() == request.auth.token.email.lower();
    }
    function teamJoinInviteData() {
      return get(/databases/$(database)/documents/teamInvites/$(request.resource.data.joinCode)).data;
    }
    function staffJoinInviteData() {
      return get(/databases/$(database)/documents/staffInvites/$(request.resource.data.joinCode)).data;
    }
    function staffJoinInviteValidForTeam(teamId) {
      return staffJoinInviteData().active == true
        && staffJoinInviteData().teamIds.hasAny([teamId])
        && isTeamAdmin(teamId, staffJoinInviteData().createdBy)
        && (!('expiresAt' in staffJoinInviteData()) ||
            staffJoinInviteData().expiresAt > request.time);
    }

    match /teams/{teamId} {
      allow read: if canReadTeamResource();

      // Team creation: auth only — must NOT call isTeamAdmin/isTeamMember (doc does not exist yet).
      allow create: if isValidNewTeamCreate();

      allow update: if request.auth != null && isTeamAdmin(teamId, request.auth.uid);

      allow delete: if request.auth != null &&
                       resource.data.ownerId == request.auth.uid;

      // Self-join via team invite (no admin role; no role escalation for existing members).
      allow update: if request.auth != null
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'memberUids', 'updatedAt', 'joinCode'])
        && request.resource.data.members.diff(resource.data.members)
             .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.memberUids.hasAll([request.auth.uid])
        && request.resource.data.memberUids.toSet()
             .difference(resource.data.memberUids.toSet()).hasOnly([request.auth.uid])
        && resource.data.memberUids.toSet()
             .difference(request.resource.data.memberUids.toSet()).size() == 0
        && request.resource.data.members[request.auth.uid] != 'admin'
        && (request.resource.data.members[request.auth.uid] == 'coach' ||
            request.resource.data.members[request.auth.uid] == 'parent' ||
            request.resource.data.members[request.auth.uid] == 'player' ||
            request.resource.data.members[request.auth.uid] == 'viewer')
        && 'joinCode' in request.resource.data
        && (
          (teamJoinInviteData().teamId == teamId
            && teamJoinInviteData().active == true
            && teamJoinInviteData().role == request.resource.data.members[request.auth.uid]
            && (!('expiresAt' in teamJoinInviteData()) ||
                teamJoinInviteData().expiresAt > request.time))
          ||
          (staffJoinInviteValidForTeam(teamId)
            && staffJoinInviteData().role == request.resource.data.members[request.auth.uid])
        );

      allow update: if request.auth != null
        && (request.auth.uid in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinCode'])
        && !('joinCode' in request.resource.data);

      match /players/{playerId} {
        allow read: if request.auth != null && isTeamMember(teamId, request.auth.uid);
        allow create, update: if request.auth != null &&
                                 isTeamCoach(teamId, request.auth.uid);
        allow delete: if request.auth != null && (
          isTeamCoach(teamId, request.auth.uid) ||
          teamData(teamId).ownerId == request.auth.uid
        );
        // Parent self-onboarding: may add only their uid to parentUids.
        allow update: if request.auth != null &&
                         isTeamMember(teamId, request.auth.uid) &&
                         teamRoleOf(teamId, request.auth.uid) == 'parent' &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['parentUids', 'updatedAt']) &&
                         request.resource.data.parentUids.toSet()
                           .difference(resource.data.get('parentUids', []).toSet())
                           .hasOnly([request.auth.uid]) &&
                         resource.data.get('parentUids', []).toSet()
                           .difference(request.resource.data.parentUids.toSet())
                           .size() == 0;
      }

      match /parentInviteTargets/{targetId} {
        allow read: if request.auth != null && (
          isTeamCoach(teamId, request.auth.uid) ||
          (isTeamMember(teamId, request.auth.uid) &&
           resource.data.joinedUid == request.auth.uid)
        );
        allow create, update: if request.auth != null &&
                                 isTeamCoach(teamId, request.auth.uid);
        allow delete: if request.auth != null && (
          isTeamCoach(teamId, request.auth.uid) ||
          teamData(teamId).ownerId == request.auth.uid
        );
        // Parent self-onboarding after invite redeem (email must match roster).
        allow update: if request.auth != null &&
                         isTeamMember(teamId, request.auth.uid) &&
                         teamRoleOf(teamId, request.auth.uid) == 'parent' &&
                         parentInviteEmailMatchesAuth() &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'joinedUid', 'joinedAt', 'updatedAt']) &&
                         request.resource.data.joinedUid == request.auth.uid &&
                         request.resource.data.status == 'joined';
      }
    }

    // ---- Team invites (join links) ------------------------------------
    match /teamInvites/{code} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.code == code
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.teamId is string
        && (request.resource.data.role == 'coach' ||
            request.resource.data.role == 'parent' ||
            request.resource.data.role == 'player' ||
            request.resource.data.role == 'viewer')
        && request.resource.data.active is bool
        && (isTeamAdminOf(request.resource.data.teamId) ||
            isTeamCoachOf(request.resource.data.teamId));

      allow update, delete: if request.auth != null
        && isTeamAdminOf(resource.data.teamId);
    }

    // ---- Staff invites (multi-team join links) ------------------------
    match /staffInvites/{code} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.code == code
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.teamIds is list
        && request.resource.data.teamIds.size() > 0
        && request.resource.data.eventLabel is string
        && (request.resource.data.role == 'coach' ||
            request.resource.data.role == 'parent' ||
            request.resource.data.role == 'player' ||
            request.resource.data.role == 'viewer')
        && request.resource.data.active is bool;

      allow update, delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }

    // ---- Games --------------------------------------------------------
    function gameData(gid) {
      return get(/databases/$(database)/documents/games/$(gid)).data;
    }
    function roleOf(gid, uid) {
      return gameContributorRole(gameData(gid), uid);
    }
    function gameContributorRole(g, uid) {
      return g.contributors is map && uid in g.contributors
        ? (g.contributors[uid] is string
            ? g.contributors[uid]
            : (g.contributors[uid] is map && g.contributors[uid].role is string
                ? g.contributors[uid].role
                : null))
        : null;
    }
    function gameContributorPresent(g, uid) {
      return gameContributorRole(g, uid) != null;
    }
    function isOwner(gid, uid) {
      return gameData(gid).ownerId == uid || roleOf(gid, uid) == 'owner';
    }
    function isEditor(gid, uid) {
      return roleOf(gid, uid) == 'editor' || isOwner(gid, uid);
    }
    /** Game doc update/delete checks using resource.data (no get()). */
    function isOwnerResource() {
      return request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        gameContributorRole(resource.data, request.auth.uid) == 'owner'
      );
    }
    function isEditorResource() {
      return request.auth != null && (
        isOwnerResource() ||
        gameContributorRole(resource.data, request.auth.uid) == 'editor'
      );
    }
    function gameTeamId(gid) {
      let g = gameData(gid);
      return 'teamId' in g && g.teamId is string
        && g.teamId.size() > 0
        ? g.teamId
        : null;
    }
    function gameHasTeam(gid) {
      let tid = gameTeamId(gid);
      return tid != null && tid.size() > 0;
    }
    /** Source/event writes: owner, editor, or team coach/parent/admin on linked games. */
    function canAttachGameSource(gid, uid) {
      let g = gameData(gid);
      return g.ownerId == uid ||
             gameContributorRole(g, uid) == 'owner' ||
             gameContributorRole(g, uid) == 'editor' ||
             ('teamId' in g &&
              g.teamId is string &&
              g.teamId.size() > 0 &&
              canTeamContributeSources(g.teamId, uid));
    }
    function canWriteGameEvent(gid, uid) {
      let g = gameData(gid);
      return g.ownerId == uid ||
             gameContributorRole(g, uid) == 'owner' ||
             gameContributorRole(g, uid) == 'editor' ||
             ('teamId' in g &&
              g.teamId is string &&
              g.teamId.size() > 0 &&
              isTeamCoach(g.teamId, uid));
    }
    /** Parent game doc read via get() — for single-doc subcollection reads. */
    function canReadGameFromParent(gid, uid) {
      let g = gameData(gid);
      return g.ownerId == uid ||
             gameContributorPresent(g, uid) ||
             (g.memberUids is list && uid in g.memberUids) ||
             g.visibility == 'public' ||
             g.visibility == 'link' ||
             ('teamId' in g && g.teamId is string && isTeamMember(g.teamId, uid));
    }
    /** Query-safe read using denormalized fields on subdocuments. */
    function canReadGameSubdocData(data) {
      return request.auth != null && (
        data.gameOwnerId == request.auth.uid ||
        (data.gameMemberUids is list &&
         request.auth.uid in data.gameMemberUids) ||
        ('gameTeamId' in data &&
         data.gameTeamId is string &&
         isTeamMember(data.gameTeamId, request.auth.uid))
      );
    }
    /** Query-compatible game read (resource.data — not get()). */
    function canReadGameResource() {
      return request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        gameContributorPresent(resource.data, request.auth.uid) ||
        (resource.data.memberUids is list &&
         request.auth.uid in resource.data.memberUids) ||
        resource.data.visibility == 'public' ||
        resource.data.visibility == 'link' ||
        ('teamId' in resource.data &&
         resource.data.teamId is string &&
         isTeamMember(resource.data.teamId, request.auth.uid))
      );
    }

    function isGameOwnerOf(gid) {
      return request.auth != null &&
             (get(/databases/$(database)/documents/games/$(gid)).data.ownerId == request.auth.uid ||
              gameContributorRole(get(/databases/$(database)/documents/games/$(gid)).data, request.auth.uid) == 'owner');
    }

    function joinInviteData() {
      return get(/databases/$(database)/documents/gameInvites/$(request.resource.data.joinCode)).data;
    }

    match /games/{gameId} {
      allow read: if canReadGameResource();

      // Standalone games (no teamId) or team games created by admin/coach.
      allow create: if request.auth != null &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.contributors is map &&
                       request.resource.data.contributors[request.auth.uid] == 'owner' &&
                       request.resource.data.memberUids is list &&
                       request.resource.data.memberUids.hasAll([request.auth.uid]) &&
                       (!('teamId' in request.resource.data) ||
                        (request.resource.data.teamId is string &&
                         isTeamCoach(request.resource.data.teamId, request.auth.uid)));

      allow update, delete: if isOwnerResource();

      // Editors may maintain subcollection index mirrors without full owner rights.
      allow update: if isEditorResource()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['sourceIds', 'eventIds', 'updatedAt']);

      // Team coaches/parents may maintain index mirrors on team-linked games.
      allow update: if request.auth != null
        && resource.data.teamId is string
        && resource.data.teamId.size() > 0
        && canTeamContributeSources(resource.data.teamId, request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['sourceIds', 'eventIds', 'updatedAt']);

      // Team coaches/parents may add themselves as game editors on team-linked games.
      allow update: if request.auth != null
        && resource.data.teamId is string
        && resource.data.teamId.size() > 0
        && canTeamContributeSources(resource.data.teamId, request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['contributors', 'memberUids', 'updatedAt'])
        && request.resource.data.contributors.diff(resource.data.get('contributors', {})).affectedKeys()
             .hasOnly([request.auth.uid])
        && request.resource.data.contributors[request.auth.uid] == 'editor'
        && request.resource.data.memberUids.toSet()
             .difference(resource.data.get('memberUids', []).toSet()).hasOnly([request.auth.uid]);

      // Claim legacy games with no ownerId (authenticated user becomes owner).
      allow update: if request.auth != null
        && resource.data.get('ownerId', '') == ''
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.contributors[request.auth.uid] == 'owner'
        && request.resource.data.memberUids.hasAll([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ownerId', 'contributors', 'memberUids', 'updatedAt']);

      allow update: if request.auth != null
        && resource.data.contributors is map
        && !(request.auth.uid in resource.data.contributors)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['contributors', 'memberUids', 'updatedAt', 'joinCode'])
        && request.resource.data.contributors.diff(resource.data.contributors)
             .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.memberUids.hasAll([request.auth.uid])
        && request.resource.data.memberUids.toSet()
             .difference(resource.data.memberUids.toSet()).hasOnly([request.auth.uid])
        && resource.data.memberUids.toSet()
             .difference(request.resource.data.memberUids.toSet()).size() == 0
        && (request.resource.data.contributors[request.auth.uid] == 'editor' ||
            request.resource.data.contributors[request.auth.uid] == 'viewer')
        && 'joinCode' in request.resource.data
        && joinInviteData().gameId == gameId
        && joinInviteData().active == true
        && joinInviteData().role == request.resource.data.contributors[request.auth.uid]
        && (!('expiresAt' in joinInviteData()) ||
            joinInviteData().expiresAt > request.time);

      allow update: if request.auth != null
        && resource.data.contributors is map
        && (request.auth.uid in resource.data.contributors)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinCode'])
        && !('joinCode' in request.resource.data);

      match /sources/{sourceId} {
        allow read: if canReadGameSubdocData(resource.data) ||
                       (request.auth != null &&
                        canReadGameFromParent(gameId, request.auth.uid));
        allow create, update, delete: if request.auth != null &&
          canAttachGameSource(gameId, request.auth.uid);
      }
      match /events/{eventId} {
        allow read: if canReadGameSubdocData(resource.data) ||
                       (request.auth != null &&
                        canReadGameFromParent(gameId, request.auth.uid));
        allow create, update, delete: if request.auth != null &&
          canWriteGameEvent(gameId, request.auth.uid);
      }
      match /cuts/{cutId} {
        allow read: if isPublicSharedHighlightReel() ||
                       (request.auth != null &&
                        (resource.data.createdBy == request.auth.uid ||
                         (resource.data.visibility != 'private' &&
                          (canReadGameSubdocData(resource.data) ||
                           canReadGameFromParent(gameId, request.auth.uid)))));
        allow create: if request.auth != null &&
                         request.resource.data.createdBy == request.auth.uid &&
                         (isEditor(gameId, request.auth.uid) ||
                          (gameHasTeam(gameId) && isTeamMember(gameTeamId(gameId), request.auth.uid)));
        allow update, delete: if request.auth != null &&
                                 (isOwner(gameId, request.auth.uid) ||
                                  resource.data.createdBy == request.auth.uid);
      }
    }

    match /{path=**}/cuts/{cutId} {
      allow read: if isPublicSharedHighlightReel();
    }

    // Public highlight reel watch links (anonymous read by share id).
    match /highlightReelShares/{shareId} {
      allow read: if true;
      allow create, update: if request.auth != null &&
                               request.resource.data.createdBy == request.auth.uid &&
                               request.resource.data.shareId == shareId;
      allow delete: if request.auth != null &&
                       resource.data.createdBy == request.auth.uid;
    }

    // ---- Import batches (event/season team groups) --------------------
    match /importBatches/{batchId} {
      allow read: if request.auth != null &&
                     resource.data.createdBy == request.auth.uid;
      allow create: if request.auth != null &&
                       request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null &&
                               resource.data.createdBy == request.auth.uid;
    }

    // ---- Game invites (join links) ------------------------------------
    match /gameInvites/{code} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.code == code
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.gameId is string
        && (request.resource.data.role == 'editor' ||
            request.resource.data.role == 'viewer')
        && request.resource.data.active is bool
        && isGameOwnerOf(request.resource.data.gameId);

      allow update, delete: if request.auth != null
        && isGameOwnerOf(resource.data.gameId);
    }
  }
}
