rules_version = '2';

// Film Room Firestore security rules.
//
// Conservative owner/editor/viewer model for Games (Phase 0) plus the existing
// per-user savedSessions. Realtime Database rooms are NOT covered here (they use
// RTDB rules separately).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Per-user saved session templates -----------------------------
    // Owner read/write requires auth + uid ownership. Shared templates are
    // publicly readable (including signed-out) only when explicitly shared
    // with a non-empty shareId — this powers the /shared/[shareId] links.
    function isPublicSharedSession() {
      return resource.data.isShared == true &&
             resource.data.shareId is string &&
             resource.data.shareId.size() > 0;
    }

    match /users/{userId}/savedSessions/{sessionId} {
      allow read: if (request.auth != null && request.auth.uid == userId) ||
                     isPublicSharedSession();
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Collection-group reads for shared templates (link sharing). Signed-out
    // viewers can open a valid share link; the client query is constrained to
    // `shareId == <id>` and `isShared == true`, which satisfies this rule.
    match /{path=**}/savedSessions/{sessionId} {
      allow read: if isPublicSharedSession();
    }

    // ---- Games --------------------------------------------------------
    function gameData() {
      return get(/databases/$(database)/documents/games/$(gameId)).data;
    }
    function roleOf(uid) {
      return gameData().contributors[uid];
    }
    function isOwner(uid) {
      return gameData().ownerId == uid || roleOf(uid) == 'owner';
    }
    function isEditor(uid) {
      return roleOf(uid) == 'editor' || isOwner(uid);
    }
    function isMember(uid) {
      return roleOf(uid) != null || isOwner(uid);
    }
    function canReadGame(uid) {
      return isMember(uid) ||
             gameData().visibility == 'public' ||
             gameData().visibility == 'link';
    }

    match /games/{gameId} {
      // Read: members always; non-members only if link/public.
      allow read: if request.auth != null && canReadGame(request.auth.uid);

      // Create: the creator must make themselves the owner.
      allow create: if request.auth != null &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.contributors[request.auth.uid] == 'owner';

      // Update/delete: owners only. Because `contributors` and `memberUids`
      // live on this doc, only owners can add/remove people or change roles —
      // editors/viewers cannot escalate their own role.
      allow update, delete: if request.auth != null && isOwner(request.auth.uid);

      // Sub-collections: sources, events, cuts.
      match /sources/{sourceId} {
        allow read: if request.auth != null && canReadGame(request.auth.uid);
        allow create, update, delete: if request.auth != null && isEditor(request.auth.uid);
      }
      match /events/{eventId} {
        allow read: if request.auth != null && canReadGame(request.auth.uid);
        allow create, update, delete: if request.auth != null && isEditor(request.auth.uid);
      }
      match /cuts/{cutId} {
        // Read: the author always; everyone else only for non-private cuts they
        // can see. Clients MUST list with constrained queries (createdBy == me,
        // or visibility in ['game','team']) — an unconstrained list is denied
        // because private cuts owned by others fail this rule.
        allow read: if request.auth != null &&
                       (resource.data.createdBy == request.auth.uid ||
                        (canReadGame(request.auth.uid) &&
                         resource.data.visibility != 'private'));
        // Editors can create cuts; only the cut's author or an owner can change it.
        allow create: if request.auth != null && isEditor(request.auth.uid) &&
                         request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if request.auth != null &&
                                 (isOwner(request.auth.uid) ||
                                  resource.data.createdBy == request.auth.uid);
      }
    }

    // Default deny: no public writes, nothing else readable.
  }
}
