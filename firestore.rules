rules_version = '2';

// Film Room Firestore security rules.
//
// Conservative owner/editor/viewer model for Games (Phase 0) plus Teams (Phase 1–2)
// and the existing per-user savedSessions. Realtime Database rooms are NOT
// covered here (they use RTDB rules separately).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Per-user saved session templates -----------------------------
    function isPublicSharedSession() {
      return resource.data.isShared == true &&
             resource.data.shareId is string &&
             resource.data.shareId.size() > 0;
    }

    match /users/{userId}/savedSessions/{sessionId} {
      allow read: if (request.auth != null && request.auth.uid == userId) ||
                     isPublicSharedSession();
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/uploadJobs/{jobId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /{path=**}/savedSessions/{sessionId} {
      allow read: if isPublicSharedSession();
    }

    // ---- Teams --------------------------------------------------------
    function teamData(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data;
    }
    function teamRoleOf(teamId, uid) {
      return teamData(teamId).members[uid];
    }
    function isTeamMember(teamId, uid) {
      return teamData(teamId).ownerId == uid || teamRoleOf(teamId, uid) != null;
    }
    function isTeamAdmin(teamId, uid) {
      return teamData(teamId).ownerId == uid || teamRoleOf(teamId, uid) == 'admin';
    }
    function isTeamCoach(teamId, uid) {
      let role = teamRoleOf(teamId, uid);
      return isTeamAdmin(teamId, uid) || role == 'coach';
    }
    function canTeamContributeSources(teamId, uid) {
      let role = teamRoleOf(teamId, uid);
      return isTeamAdmin(teamId, uid) || role == 'coach' || role == 'parent';
    }
    function isTeamCoachOf(tid) {
      return request.auth != null && isTeamCoach(tid, request.auth.uid);
    }
    function isTeamAdminOf(tid) {
      return request.auth != null && isTeamAdmin(tid, request.auth.uid);
    }
    function isValidNewTeamCreate() {
      return request.auth != null &&
             request.resource.data.ownerId == request.auth.uid &&
             request.resource.data.members is map &&
             request.resource.data.memberUids is list &&
             request.resource.data.members[request.auth.uid] == 'admin' &&
             request.resource.data.memberUids.hasAll([request.auth.uid]);
    }
    /** Query-compatible team read (resource.data — not get()). */
    function canReadTeamResource() {
      return request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.memberUids
      );
    }
    function parentInviteEmailMatchesAuth() {
      return request.auth != null &&
             request.auth.token.email is string &&
             resource.data.email is string &&
             resource.data.email.lower() == request.auth.token.email.lower();
    }
    function teamJoinInviteData() {
      return get(/databases/$(database)/documents/teamInvites/$(request.resource.data.joinCode)).data;
    }

    match /teams/{teamId} {
      allow read: if canReadTeamResource();

      // Team creation: auth only — must NOT call isTeamAdmin/isTeamMember (doc does not exist yet).
      allow create: if isValidNewTeamCreate();

      allow update: if request.auth != null && isTeamAdmin(teamId, request.auth.uid);

      allow delete: if request.auth != null &&
                       resource.data.ownerId == request.auth.uid;

      // Self-join via team invite (no admin role; no role escalation for existing members).
      allow update: if request.auth != null
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'memberUids', 'updatedAt', 'joinCode'])
        && request.resource.data.members.diff(resource.data.members)
             .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.memberUids.hasAll([request.auth.uid])
        && request.resource.data.memberUids.toSet()
             .difference(resource.data.memberUids.toSet()).hasOnly([request.auth.uid])
        && resource.data.memberUids.toSet()
             .difference(request.resource.data.memberUids.toSet()).size() == 0
        && request.resource.data.members[request.auth.uid] != 'admin'
        && (request.resource.data.members[request.auth.uid] == 'coach' ||
            request.resource.data.members[request.auth.uid] == 'parent' ||
            request.resource.data.members[request.auth.uid] == 'player' ||
            request.resource.data.members[request.auth.uid] == 'viewer')
        && 'joinCode' in request.resource.data
        && teamJoinInviteData().teamId == teamId
        && teamJoinInviteData().active == true
        && teamJoinInviteData().role == request.resource.data.members[request.auth.uid]
        && (!('expiresAt' in teamJoinInviteData()) ||
            teamJoinInviteData().expiresAt > request.time);

      allow update: if request.auth != null
        && (request.auth.uid in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinCode'])
        && !('joinCode' in request.resource.data);

      match /players/{playerId} {
        allow read: if request.auth != null && isTeamMember(teamId, request.auth.uid);
        allow create, update: if request.auth != null &&
                                 isTeamCoach(teamId, request.auth.uid);
        allow delete: if request.auth != null && (
          isTeamCoach(teamId, request.auth.uid) ||
          teamData(teamId).ownerId == request.auth.uid
        );
        // Parent self-onboarding: may add only their uid to parentUids.
        allow update: if request.auth != null &&
                         isTeamMember(teamId, request.auth.uid) &&
                         teamRoleOf(teamId, request.auth.uid) == 'parent' &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['parentUids', 'updatedAt']) &&
                         request.resource.data.parentUids.toSet()
                           .difference(resource.data.get('parentUids', []).toSet())
                           .hasOnly([request.auth.uid]) &&
                         resource.data.get('parentUids', []).toSet()
                           .difference(request.resource.data.parentUids.toSet())
                           .size() == 0;
      }

      match /parentInviteTargets/{targetId} {
        allow read: if request.auth != null && (
          isTeamCoach(teamId, request.auth.uid) ||
          (isTeamMember(teamId, request.auth.uid) &&
           resource.data.joinedUid == request.auth.uid)
        );
        allow create, update: if request.auth != null &&
                                 isTeamCoach(teamId, request.auth.uid);
        allow delete: if request.auth != null && (
          isTeamCoach(teamId, request.auth.uid) ||
          teamData(teamId).ownerId == request.auth.uid
        );
        // Parent self-onboarding after invite redeem (email must match roster).
        allow update: if request.auth != null &&
                         isTeamMember(teamId, request.auth.uid) &&
                         teamRoleOf(teamId, request.auth.uid) == 'parent' &&
                         parentInviteEmailMatchesAuth() &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'joinedUid', 'joinedAt', 'updatedAt']) &&
                         request.resource.data.joinedUid == request.auth.uid &&
                         request.resource.data.status == 'joined';
      }
    }

    // ---- Team invites (join links) ------------------------------------
    match /teamInvites/{code} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.code == code
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.teamId is string
        && (request.resource.data.role == 'coach' ||
            request.resource.data.role == 'parent' ||
            request.resource.data.role == 'player' ||
            request.resource.data.role == 'viewer')
        && request.resource.data.active is bool
        && (isTeamAdminOf(request.resource.data.teamId) ||
            isTeamCoachOf(request.resource.data.teamId));

      allow update, delete: if request.auth != null
        && isTeamAdminOf(resource.data.teamId);
    }

    // ---- Games --------------------------------------------------------
    function gameData() {
      return get(/databases/$(database)/documents/games/$(gameId)).data;
    }
    function roleOf(uid) {
      return gameData().contributors[uid];
    }
    function isOwner(uid) {
      return gameData().ownerId == uid || roleOf(uid) == 'owner';
    }
    function isEditor(uid) {
      return roleOf(uid) == 'editor' || isOwner(uid);
    }
    function isMember(uid) {
      return roleOf(uid) != null || isOwner(uid);
    }
    function gameTeamId() {
      return 'teamId' in gameData() && gameData().teamId is string
        ? gameData().teamId
        : null;
    }
    function gameHasTeam() {
      return gameTeamId() != null;
    }
    function canReadGame(uid) {
      return isMember(uid) ||
             gameData().visibility == 'public' ||
             gameData().visibility == 'link' ||
             (gameHasTeam() && isTeamMember(gameTeamId(), uid));
    }
    /** Query-compatible game read (resource.data — not get()). */
    function canReadGameResource() {
      return request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.contributors[request.auth.uid] != null ||
        request.auth.uid in resource.data.memberUids ||
        resource.data.visibility == 'public' ||
        resource.data.visibility == 'link'
      );
    }
    /** Team member read for games linked to a team (single-doc; uses get). */
    function canReadGameViaTeam(uid) {
      return 'teamId' in resource.data &&
             resource.data.teamId is string &&
             isTeamMember(resource.data.teamId, uid);
    }

    function isGameOwnerOf(gid) {
      return request.auth != null &&
             (get(/databases/$(database)/documents/games/$(gid)).data.ownerId == request.auth.uid ||
              get(/databases/$(database)/documents/games/$(gid)).data.contributors[request.auth.uid] == 'owner');
    }

    function joinInviteData() {
      return get(/databases/$(database)/documents/gameInvites/$(request.resource.data.joinCode)).data;
    }

    match /games/{gameId} {
      allow read: if canReadGameResource() ||
                     (request.auth != null && canReadGameViaTeam(request.auth.uid));

      // Standalone games (no teamId) or team games created by admin/coach.
      allow create: if request.auth != null &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.contributors[request.auth.uid] == 'owner' &&
                       (!('teamId' in request.resource.data) ||
                        (request.resource.data.teamId is string &&
                         isTeamCoach(request.resource.data.teamId, request.auth.uid)));

      allow update, delete: if request.auth != null && isOwner(request.auth.uid);

      allow update: if request.auth != null
        && !(request.auth.uid in resource.data.contributors)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['contributors', 'memberUids', 'updatedAt', 'joinCode'])
        && request.resource.data.contributors.diff(resource.data.contributors)
             .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.memberUids.hasAll([request.auth.uid])
        && request.resource.data.memberUids.toSet()
             .difference(resource.data.memberUids.toSet()).hasOnly([request.auth.uid])
        && resource.data.memberUids.toSet()
             .difference(request.resource.data.memberUids.toSet()).size() == 0
        && (request.resource.data.contributors[request.auth.uid] == 'editor' ||
            request.resource.data.contributors[request.auth.uid] == 'viewer')
        && 'joinCode' in request.resource.data
        && joinInviteData().gameId == gameId
        && joinInviteData().active == true
        && joinInviteData().role == request.resource.data.contributors[request.auth.uid]
        && (!('expiresAt' in joinInviteData()) ||
            joinInviteData().expiresAt > request.time);

      allow update: if request.auth != null
        && (request.auth.uid in resource.data.contributors)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinCode'])
        && !('joinCode' in request.resource.data);

      match /sources/{sourceId} {
        allow read: if request.auth != null && canReadGame(request.auth.uid);
        allow create, update, delete: if request.auth != null &&
          (isEditor(request.auth.uid) ||
           (gameHasTeam() && canTeamContributeSources(gameTeamId(), request.auth.uid)));
      }
      match /events/{eventId} {
        allow read: if request.auth != null && canReadGame(request.auth.uid);
        allow create, update, delete: if request.auth != null &&
          (isEditor(request.auth.uid) ||
           (gameHasTeam() && isTeamCoach(gameTeamId(), request.auth.uid)));
      }
      match /cuts/{cutId} {
        allow read: if request.auth != null &&
                       (resource.data.createdBy == request.auth.uid ||
                        (canReadGame(request.auth.uid) &&
                         resource.data.visibility != 'private'));
        allow create: if request.auth != null &&
                         request.resource.data.createdBy == request.auth.uid &&
                         (isEditor(request.auth.uid) ||
                          (gameHasTeam() && isTeamMember(gameTeamId(), request.auth.uid)));
        allow update, delete: if request.auth != null &&
                                 (isOwner(request.auth.uid) ||
                                  resource.data.createdBy == request.auth.uid);
      }
    }

    // ---- Game invites (join links) ------------------------------------
    match /gameInvites/{code} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.code == code
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.gameId is string
        && (request.resource.data.role == 'editor' ||
            request.resource.data.role == 'viewer')
        && request.resource.data.active is bool
        && isGameOwnerOf(request.resource.data.gameId);

      allow update, delete: if request.auth != null
        && isGameOwnerOf(resource.data.gameId);
    }
  }
}
