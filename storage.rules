rules_version = '2';

// Team logos — public read; authenticated write on logo paths only.
// Team doc logoUrl updates are still enforced by Firestore rules (admins only).
service firebase.storage {
  match /b/{bucket}/o {
    match /teams/{teamId}/{logoFile} {
      allow read: if true;
      allow write: if request.auth != null
        && logoFile.matches('logo\\.(png|jpg|jpeg|webp|gif)')
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
    }
  }
}
