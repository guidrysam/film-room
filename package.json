{
  "name": "film-room",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test lib/**/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project film-room-b7780 \"tsx --test lib/firestore-rules.test.ts\"",
    "deploy:rules": "firebase deploy --only firestore:rules --project film-room-b7780",
    "academy:sources:register": "tsx scripts/academy/register-sources.ts",
    "academy:sources:extract": "tsx scripts/academy/extract-pdf-text.ts",
    "academy:sources:index": "tsx scripts/academy/build-source-index.ts",
    "academy:sources:queue": "tsx scripts/academy/create-editorial-queue.ts",
    "academy:catalog:candidates": "tsx scripts/academy/build-knowledge-candidates.ts",
    "academy:catalog:validate": "tsx scripts/academy/validate-canonical-catalog.ts",
    "academy:catalog:publish": "tsx scripts/academy/publish-canonical-catalog.ts",
    "academy:editorial:seed": "tsx scripts/academy/seed-editorial-package.ts",
    "academy:editorial:seed-block1": "tsx scripts/academy/seed-block1-editorial.ts",
    "academy:editorial:transition": "tsx scripts/academy/transition-editorial.ts",
    "academy:editorial:approve-package": "tsx scripts/academy/approve-editorial-package.ts",
    "academy:editorial:publish-package": "tsx scripts/academy/publish-editorial-package.ts",
    "academy:editorial:unpublish-package": "tsx scripts/academy/unpublish-editorial-package.ts",
    "academy:validate": "tsx scripts/academy/validate-source-index.ts",
    "academy:goals:validate": "tsx scripts/academy/generate-u12-goal-reports.ts",
    "academy:sources:all": "npm run academy:sources:register && npm run academy:sources:extract && npm run academy:sources:index && npm run academy:sources:queue && npm run academy:catalog:candidates && npm run academy:validate",
    "ai:grant-credits": "tsx scripts/ai/grant-test-credits.ts",
    "ai:eval-tag": "tsx scripts/ai/eval-tag-modes.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.23",
    "ai": "^7.0.36",
    "firebase": "^12.12.0",
    "firebase-admin": "^14.2.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-youtube": "^10.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "firebase-tools": "^15.21.0",
    "pdf-parse": "^2.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5"
  },
  "overrides": {
    "jose": "4.15.9"
  }
}
