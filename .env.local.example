YOUTUBE_DATA_API_KEY=your_youtube_data_api_key_here

# Meta app id for Facebook embedded video (Film Room teaching / cue rooms).
# Create at https://developers.facebook.com/ — add your site domain under App Domains.
NEXT_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id_here

# Team Academy nav + Game Review Develop tab. Required outside local `next dev`.
NEXT_PUBLIC_ACADEMY_ENABLED=true

# Parent invite emails (Resend). Without RESEND_API_KEY, "Send invite" is disabled.
# https://resend.com/api-keys — verify a domain, then set PARENT_INVITE_FROM_EMAIL.
RESEND_API_KEY=re_xxxxxxxx
PARENT_INVITE_FROM_EMAIL="Film Room <invites@yourdomain.com>"
# Optional absolute site URL used in invite links when Origin header is missing.
# Also used as Firebase authDomain hostname (Safari Google redirect).
NEXT_PUBLIC_APP_URL=https://film-room-gray.vercel.app
# Optional override; defaults to hostname of NEXT_PUBLIC_APP_URL.
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=film-room-gray.vercel.app
#
# Google Cloud OAuth (Firebase-managed Web client) must allow:
#   https://film-room-gray.vercel.app/__/auth/handler
#   http://localhost:3000/__/auth/handler
# Firebase Console → Authentication → Settings → Authorized domains must include
# film-room-gray.vercel.app (and localhost for local).

# --- Team Drive vault + personal My Film inbox ---
# Google Cloud OAuth client (Web). Same client for Drive + YouTube upload offline.
# Redirect URIs:
#   {NEXT_PUBLIC_APP_URL}/api/drive/oauth/callback
#   {NEXT_PUBLIC_APP_URL}/api/youtube/oauth/callback
# Enable Google Drive API + YouTube Data API v3. Scopes: drive.file (Drive connect)
# and youtube.upload + youtube.readonly (YouTube upload connect) — never together.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# 64-char hex preferred, or any passphrase (SHA-256'd) for AES-GCM token encryption
DRIVE_TOKEN_ENCRYPTION_KEY=

# --- AI Tag / Sync (Phase A: test first) ---
# Gemini (Google AI Studio). Required for AI Tag / Sync APIs and eval script.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional alternate; used if GOOGLE_GENERATIVE_AI_API_KEY is unset.
# AI_GATEWAY_API_KEY=
# Optional notes only — runtime hard-pins gemini-3.6-flash (2.5 blocked for new keys).
# AI_TAG_MODEL=gemini-3.6-flash
# AI_SYNC_MODEL=gemini-3.6-flash

# Purchase off by default — use club hub "Grant test credits" or:
#   npx tsx scripts/ai/grant-test-credits.ts --club <clubId> --amount 500
AI_CREDITS_PURCHASE_ENABLED=false
NEXT_PUBLIC_AI_CREDITS_PURCHASE_ENABLED=false
# When purchase is later enabled, set both to true and configure Stripe (Phase B).
# AI_CREDITS_ALLOW_TEST_GRANT=true
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_CREDITS_STARTER=

